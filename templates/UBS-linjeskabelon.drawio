<mxfile host="app.diagrams.net" compressed="false"><diagram name="Vejledning" id="vejledning"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="1040" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t-1" value="&lt;font style=&quot;font-size: 30px;&quot;&gt;&lt;b&gt;UBS linjeskabelon&lt;/b&gt;&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#18201E;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="700" height="40" as="geometry"/></mxCell><mxCell id="t-2" value="&lt;font style=&quot;font-size: 14px;&quot; color=&quot;#5B6763&quot;&gt;Sådan tegner du en produktionslinje, så den kan læses direkte ind i fabrikskortet.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#18201E;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="74" width="700" height="24" as="geometry"/></mxCell><mxCell id="t-3" value="&lt;font style=&quot;font-size: 16px;&quot;&gt;&lt;b&gt;Sådan gør du&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;1. Én fane pr. linje.&lt;/b&gt; Opret en ny fane og kald den &lt;i&gt;Linje 3 – Renselinjen&lt;/i&gt; (nummer og navn). Faner der starter med &lt;i&gt;Vejledning&lt;/i&gt; eller &lt;i&gt;_&lt;/i&gt; bliver ikke læst.&lt;br&gt;&lt;br&gt;&lt;b&gt;2. Træk maskiner ind.&lt;/b&gt; Brug biblioteket &lt;i&gt;UBS maskiner&lt;/i&gt; (Fil → Åbn bibliotek → UBS-maskiner.xml), eller kopiér en boks herfra.&lt;br&gt;&lt;br&gt;&lt;b&gt;3. Udfyld felterne.&lt;/b&gt; Markér boksen og tryk &lt;b&gt;Ctrl+M&lt;/b&gt; (Rediger data). Navn og W-ID vises selv i boksen – skriv &lt;u&gt;ikke&lt;/u&gt; direkte i boksen.&lt;br&gt;&lt;br&gt;&lt;b&gt;4. Forbind med pile i flowretningen.&lt;/b&gt; Træk pilen fra boks til boks, til kanten bliver blå/grøn. En pil der ikke sidder fast i begge ender, tæller ikke.&lt;br&gt;&lt;br&gt;&lt;b&gt;5. Tegn oppefra og ned.&lt;/b&gt; Deler linjen sig, så læg sporene side om side og skriv sporet i feltet &lt;i&gt;spor&lt;/i&gt; (fx S og N)." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#18201E;spacing=0;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="520" height="360" as="geometry"/></mxCell><mxCell id="t-4" value="&lt;font style=&quot;font-size: 16px;&quot;&gt;&lt;b&gt;Felter (Ctrl+M)&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;table style=&quot;border-collapse:collapse;font-size:12px;width:100%;&quot;&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 8px;border-bottom:1px solid #D3D9D3;&quot;&gt;&lt;b&gt;Felt&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 8px;border-bottom:1px solid #D3D9D3;&quot;&gt;&lt;b&gt;Skal udfyldes&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 8px;border-bottom:1px solid #D3D9D3;&quot;&gt;&lt;b&gt;Eksempel / betydning&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 8px;border-bottom:1px solid #D3D9D3;font-family:Courier New;&quot;&gt;navn&lt;/td&gt;&lt;td style=&quot;padding:3px 8px;border-bottom:1px solid #D3D9D3;&quot;&gt;Ja&lt;/td&gt;&lt;td style=&quot;padding:3px 8px;border-bottom:1px solid #D3D9D3;&quot;&gt;Maskinens navn, fx Jetpealer S&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 8px;border-bottom:1px solid #D3D9D3;font-family:Courier New;&quot;&gt;wid&lt;/td&gt;&lt;td style=&quot;padding:3px 8px;border-bottom:1px solid #D3D9D3;&quot;&gt;Ja&lt;/td&gt;&lt;td style=&quot;padding:3px 8px;border-bottom:1px solid #D3D9D3;&quot;&gt;W-ID. Flere: 793/794/795&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 8px;border-bottom:1px solid #D3D9D3;font-family:Courier New;&quot;&gt;maskintype&lt;/td&gt;&lt;td style=&quot;padding:3px 8px;border-bottom:1px solid #D3D9D3;&quot;&gt;Ja&lt;/td&gt;&lt;td style=&quot;padding:3px 8px;border-bottom:1px solid #D3D9D3;&quot;&gt;Indtag, Elevator, Fordeler, Proces eller Analyse&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 8px;border-bottom:1px solid #D3D9D3;font-family:Courier New;&quot;&gt;spor&lt;/td&gt;&lt;td style=&quot;padding:3px 8px;border-bottom:1px solid #D3D9D3;&quot;&gt;Ved deling&lt;/td&gt;&lt;td style=&quot;padding:3px 8px;border-bottom:1px solid #D3D9D3;&quot;&gt;Sporets bogstav, fx S eller N&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 8px;border-bottom:1px solid #D3D9D3;font-family:Courier New;&quot;&gt;x&lt;/td&gt;&lt;td style=&quot;padding:3px 8px;border-bottom:1px solid #D3D9D3;&quot;&gt;Ved opmåling&lt;/td&gt;&lt;td style=&quot;padding:3px 8px;border-bottom:1px solid #D3D9D3;&quot;&gt;Meter mod øst fra fabrikkens nulpunkt&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 8px;border-bottom:1px solid #D3D9D3;font-family:Courier New;&quot;&gt;z&lt;/td&gt;&lt;td style=&quot;padding:3px 8px;border-bottom:1px solid #D3D9D3;&quot;&gt;Ved opmåling&lt;/td&gt;&lt;td style=&quot;padding:3px 8px;border-bottom:1px solid #D3D9D3;&quot;&gt;Meter mod syd fra fabrikkens nulpunkt&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 8px;border-bottom:1px solid #D3D9D3;font-family:Courier New;&quot;&gt;rot&lt;/td&gt;&lt;td style=&quot;padding:3px 8px;border-bottom:1px solid #D3D9D3;&quot;&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 8px;border-bottom:1px solid #D3D9D3;&quot;&gt;Grader med uret. 0 = maskinen vender mod øst&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 8px;border-bottom:1px solid #D3D9D3;font-family:Courier New;&quot;&gt;producent&lt;/td&gt;&lt;td style=&quot;padding:3px 8px;border-bottom:1px solid #D3D9D3;&quot;&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 8px;border-bottom:1px solid #D3D9D3;&quot;&gt;Fabrikat, fx Cimbria&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 8px;border-bottom:1px solid #D3D9D3;font-family:Courier New;&quot;&gt;model&lt;/td&gt;&lt;td style=&quot;padding:3px 8px;border-bottom:1px solid #D3D9D3;&quot;&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 8px;border-bottom:1px solid #D3D9D3;&quot;&gt;Modelbetegnelse&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 8px;border-bottom:1px solid #D3D9D3;font-family:Courier New;&quot;&gt;aar&lt;/td&gt;&lt;td style=&quot;padding:3px 8px;border-bottom:1px solid #D3D9D3;&quot;&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 8px;border-bottom:1px solid #D3D9D3;&quot;&gt;Årgang da maskinen blev sat op&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 8px;border-bottom:1px solid #D3D9D3;font-family:Courier New;&quot;&gt;retrofit&lt;/td&gt;&lt;td style=&quot;padding:3px 8px;border-bottom:1px solid #D3D9D3;&quot;&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 8px;border-bottom:1px solid #D3D9D3;&quot;&gt;Sidste totalrenovering: 2024, 2024-06 eller 2024-06-15&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 8px;border-bottom:1px solid #D3D9D3;font-family:Courier New;&quot;&gt;retrofitnoter&lt;/td&gt;&lt;td style=&quot;padding:3px 8px;border-bottom:1px solid #D3D9D3;&quot;&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 8px;border-bottom:1px solid #D3D9D3;&quot;&gt;Hvad renoveringen omfattede&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 8px;border-bottom:1px solid #D3D9D3;font-family:Courier New;&quot;&gt;proces&lt;/td&gt;&lt;td style=&quot;padding:3px 8px;border-bottom:1px solid #D3D9D3;&quot;&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 8px;border-bottom:1px solid #D3D9D3;&quot;&gt;Hvad maskinen gør, fx rensning, sortering&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 8px;border-bottom:1px solid #D3D9D3;font-family:Courier New;&quot;&gt;kapacitet&lt;/td&gt;&lt;td style=&quot;padding:3px 8px;border-bottom:1px solid #D3D9D3;&quot;&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 8px;border-bottom:1px solid #D3D9D3;&quot;&gt;Fx 2 t/h&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 8px;border-bottom:1px solid #D3D9D3;font-family:Courier New;&quot;&gt;dim&lt;/td&gt;&lt;td style=&quot;padding:3px 8px;border-bottom:1px solid #D3D9D3;&quot;&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 8px;border-bottom:1px solid #D3D9D3;&quot;&gt;DIM-skab maskinen hænger på&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 8px;border-bottom:1px solid #D3D9D3;font-family:Courier New;&quot;&gt;ot&lt;/td&gt;&lt;td style=&quot;padding:3px 8px;border-bottom:1px solid #D3D9D3;&quot;&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 8px;border-bottom:1px solid #D3D9D3;&quot;&gt;OT-net: IP, switch-port eller VLAN&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 8px;border-bottom:1px solid #D3D9D3;font-family:Courier New;&quot;&gt;noter&lt;/td&gt;&lt;td style=&quot;padding:3px 8px;border-bottom:1px solid #D3D9D3;&quot;&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 8px;border-bottom:1px solid #D3D9D3;&quot;&gt;Alt andet&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#18201E;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="500" width="520" height="450" as="geometry"/></mxCell><mxCell id="t-5" value="&lt;font style=&quot;font-size: 16px;&quot;&gt;&lt;b&gt;Maskintyper&lt;/b&gt;&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#18201E;spacing=0;" vertex="1" parent="1"><mxGeometry x="600" y="130" width="300" height="24" as="geometry"/></mxCell><UserObject label="&lt;b&gt;%navn%&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot; color=&quot;#5B6763&quot;&gt;W-ID: %wid%&lt;/font&gt;" placeholders="1" navn="Påslag" wid="100" maskintype="Indtag" spor="" x="" z="" rot="" producent="" model="" aar="" retrofit="" retrofitnoter="" proces="" kapacitet="" dim="" ot="" noter="" id="m-6"><mxCell style="whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fontColor=#18201E;rounded=1;arcSize=10;fillColor=#E3E7EB;strokeColor=#8B98A3;" vertex="1" parent="1"><mxGe