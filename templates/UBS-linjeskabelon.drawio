/></mxCell><mxCell id="e-21" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;strokeColor=#5D6F69;endArrow=block;endFill=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="m-14" target="m-15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e-22" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;strokeColor=#5D6F69;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="m-14" target="m-16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e-23" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;strokeColor=#5D6F69;endArrow=block;endFill=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="m-15" target="m-17"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e-24" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;strokeColor=#5D6F69;endArrow=block;endFill=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="m-16" target="m-18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n-25" value="&lt;b&gt;Tjek før du sender&lt;/b&gt;&lt;br&gt;☐ Alle bokse har navn, W-ID og maskintype&lt;br&gt;☐ Alle pile sidder fast i begge ender&lt;br&gt;☐ Sporene er udfyldt efter en fordeler&lt;br&gt;☐ Fanen hedder &lt;i&gt;Linje N – Navn&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontColor=#18201E;fillColor=#F6EFE3;strokeColor=#B7791F;rounded=1;arcSize=4;spacing=14;" vertex="1" parent="1"><mxGeometry x="620" y="720" width="420" height="110" as="geometry"/></mxCell><mxCell id="n-26" value="&lt;b&gt;Målfast placering – kun hvis linjen er målt op&lt;/b&gt;&lt;br&gt;&lt;br&gt;Felterne &lt;i&gt;x&lt;/i&gt;, &lt;i&gt;z&lt;/i&gt; og &lt;i&gt;rot&lt;/i&gt; flytter maskinerne hen, hvor de står i virkeligheden. &lt;b&gt;Lad dem stå tomme&lt;/b&gt;, hvis linjen ikke er målt op – så placeres maskinerne efter tegningen som hidtil.&lt;br&gt;&lt;br&gt;Alle mål er i meter fra fabrikkens aftalte nulpunkt. Både 12,5 og 12.5 virker. Har du målt maskinen op, kan du selv tilføje felterne &lt;i&gt;bredde&lt;/i&gt;, &lt;i&gt;dybde&lt;/i&gt; og &lt;i&gt;hoejde&lt;/i&gt;." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontColor=#18201E;fillColor=#EEF3F1;strokeColor=#2E6D64;rounded=1;arcSize=4;spacing=14;" vertex="1" parent="1"><mxGeometry x="620" y="860" width="420" height="150" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Linje N – Navn" id="linje"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n-27" value="&lt;b&gt;Start her&lt;/b&gt;&lt;br&gt;1. Omdøb fanen (dobbeltklik på fanen nederst), fx &lt;i&gt;Linje 3 – Renselinjen&lt;/i&gt;.&lt;br&gt;2. Markér boksen herunder og tryk &lt;b&gt;Ctrl+M&lt;/b&gt; for at udfylde den.&lt;br&gt;3. Slet gerne denne note, når du er i gang – den bliver ikke læst." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontColor=#18201E;fillColor=#EEF3F1;strokeColor=#2E6D64;rounded=1;arcSize=4;spacing=14;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="420" height="100" as="geometry"/></mxCell><UserObject label="&lt;b&gt;%navn%&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot; color=&quot;#5B6763&quot;&gt;W-ID: %wid%&lt;/font&gt;" placeholders="1" navn="Indtag" wid="" maskintype="Indtag" spor="" x="" z="" rot="" producent="" model="" aar="" retrofit="" retrofitnoter="" proces="" kapacitet="" dim="" ot="" noter="" id="m-28"><mxCell style="whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fontColor=#18201E;rounded=1;arcSize=10;fillColor=#E3E7EB;strokeColor=#8B98A3;" vertex="1" parent="1"><mxGeometry x="200" y="180" width="120" height="60" as="geometry"/></mxCell></UserObject></root></mxGraphModel></diagram></mxfile>
